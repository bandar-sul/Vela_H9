    <string name="settings_trip_select_all">تحديد الكل</string>
    <string name="settings_trip_more">المزيد لهذه الرحلة</string>
    <string name="settings_trip_batch_title">مشاركة الرحلات المحددة</string>
    <string name="settings_trip_batch_explain">تخرج الرحلات معًا في ملف zip واحد. تُقص كل رحلة بالمسافة نفسها: تُحذف كل نقطة قريبة من بدايتها ونهايتها ووجهتها ومن المنزل والعمل، ويُحتفظ بالمنتصف بالدقة الكاملة.</string>
    <string name="settings_trip_batch_summary">الرحلات في ملف zip: %1$d من %2$d. النقاط المحذوفة: %3$d. النقاط المتبقية: %4$d.</string>
    <string name="settings_trip_batch_left_out">تم استبعاد رحلات أقصر من مسافة القص: %1$d. قد تسمح مسافة أصغر بالإبقاء عليها.</string>
    <string name="settings_trip_batch_none">كل الرحلات المحددة أقصر من مسافة القص، لذلك لا يتبقى شيء للمشاركة. جرّب مسافة أصغر.</string>
    <string name="settings_trip_batch_confirm">مشاركة ملف zip</string>
    <string name="settings_name_trips">تسمية كل رحلة عند حفظها</string>
    <string name="settings_name_trips_hint">بعد انتهاء رحلة مسجلة، يسألك Vela عن اسمها. متوقف افتراضيًا؛ ويمكنك دائمًا إعادة تسمية الرحلة لاحقًا من القائمة أدناه.</string>
    <string name="trip_name_prompt_title">تسمية هذه الرحلة</string>
    <string name="trip_name_prompt_save">حفظ الاسم</string>
    <string name="trip_name_prompt_skip">ليس الآن</string>
    <string name="settings_no_trips_hint">لا توجد رحلات مسجلة بعد. فعّل هذا الخيار وابدأ الملاحة إلى مكان ما وستظهر الرحلة هنا لإعادة تشغيلها.</string>
    <string name="settings_trip_consent_title">حفظ رحلاتك؟</string>
    <string name="settings_trip_consent_body">سيسجل Vela مسار GPS لكل ملاحة على هذا الهاتف حتى يمكن إعادة تشغيل الرحلة للاختبار دون قيادتها مرة أخرى. هذه البيانات أكثر حساسية من التشخيص لأنها تتضمن مساراتك الدقيقة، لكنها تبقى على الهاتف ولا تُرفع أبدًا. يمكنك إيقافها في أي وقت.</string>
    <string name="settings_turn_on">تشغيل</string>
    <string name="settings_cancel">إلغاء</string>
    <string name="settings_crash_hint">أُغلق Vela بشكل غير متوقع مؤخرًا. إرسال تقرير التعطل (stack trace) يساعد في إصلاح المشكلة. هو ملف نصي عادي لا يحتوي على بيانات شخصية.</string>
    <string name="settings_crash_export">تصدير تقرير التعطل</string>
    <string name="settings_crash_discard">تجاهل</string>
    <string name="settings_crash_diag_offer">التشخيص متوقف، لذلك لم يتم تسجيل ما حدث قبل التعطل. شغّله لالتقاط تفاصيل أكثر إذا تكرر الأمر.</string>
    <string name="settings_crash_enable_diag">تشغيل التشخيص</string>
    <string name="settings_diag_consent_title">تشغيل التشخيص؟</string>
    <string name="settings_diag_consent_body">سيحتفظ Vela بسجل محلي قصير لعمليات البحث والمسارات وأي أخطاء. لا يغادر الهاتف إلا إذا ضغطت تصدير واخترت مكان الإرسال. أوقفه في أي وقت لمسح السجل.</string>
    <string name="settings_about">حول</string>
    <string name="settings_about_hint">Vela تطبيق خرائط بدون خدمات Google Play: يستخدم خرائط مفتوحة، ويستخرج بيانات الأماكن والتوجيه وأوقات الوصول المتأثرة بالمرور من Google، ويستخدم AOSP TextToSpeech للصوت. مرخص GPLv3 ولا يحتاج Play Services.</string>
    <string name="settings_support">الدعم</string>
    <string name="settings_support_hint">Vela مجاني وبدون إعلانات. إذا أصبح مفيدًا لك، فالتبرع يساعد في استمرار التطوير وهو اختياري تمامًا.</string>
