    <string name="settings_google_session_done">تم بدء جلسة Google جديدة</string>
    <string name="settings_clear_history">مسح السجل</string>
    <string name="settings_clear_history_hint">عمليات البحث الأخيرة والأماكن الأخيرة وسجل المواقف والرحلات المسجلة. تبقى الأماكن والقوائم المحفوظة.</string>
    <string name="settings_clear_history_action">مسح</string>
    <string name="settings_clear_history_confirm_title">مسح كل السجل؟</string>
    <string name="settings_clear_history_confirm_body">سيتم حذف عمليات البحث الأخيرة والأماكن الأخيرة وسجل المواقف وكل الرحلات المسجلة، ولا يمكن التراجع عن ذلك. لن تتأثر الأماكن والقوائم المحفوظة.</string>
    <string name="settings_clear_history_done">تم مسح السجل</string>
    <string name="settings_privacy_button">ما البيانات التي تستقبلها Google</string>
    <string name="settings_google_free">استخدام Vela بدون Google</string>
    <string name="settings_google_free_hint">لن يُرسل شيء إلى Google. يستخدم البحث OpenStreetMap والمناطق المنزلة لديك، وتأتي الأماكن على الخريطة من بيانات Vela، وتأتي المسارات من الموجّه المفتوح دون حركة مرور مباشرة. ستفقد المراجعات والصور وساعات العمل وأوقات الوصول المباشرة وStreet View واتجاهات النقل العام وتقريب صور الأقمار الصناعية؛ وتظل المناطق المنزلة تعمل بالكامل دون إنترنت.</string>
    <string name="settings_diagnostics">التشخيص</string>
    <string name="settings_diagnostics_hint">متوقف افتراضيًا. عند تشغيله يحتفظ Vela بسجل محلي قصير يمكنك تصديره وإرساله للمطور. لا يتم رفع شيء، وإيقافه يمسح السجل.</string>
    <string name="settings_share_diagnostics">مشاركة التشخيص</string>
    <string name="settings_diag_nothing">لم يتم تسجيل شيء بعد. استخدم التطبيق ثم صدّر السجل.</string>
    <string name="settings_diag_export">تصدير جلسة التصحيح</string>
    <string name="settings_diag_redact">إخفاء الأماكن في ملفات التصدير</string>
    <string name="settings_diag_redact_trips_hint">يخفي عمليات البحث والوجهات والروابط وأسماء الأماكن من تصدير التشخيص ويقرّب الإحداثيات إلى نحو 10 كم. تبقى التوقيتات والأعداد والأخطاء. تبدأ الرحلات المشتركة بأكبر مسافة قص.</string>
    <string name="settings_save_trips">حفظ رحلاتي (لإعادة التشغيل)</string>
    <string name="settings_save_trips_hint">يسجل مسار GPS لكل رحلة قيادة على هذا الهاتف لكي يمكن إعادة تشغيلها لاحقًا. لا يغادر الهاتف أبدًا.</string>
    <string name="settings_recorded_trips_hint">الرحلات المسجلة. اضغط إعادة التشغيل لتشغيل رحلة على الخريطة بسرعة 3×:</string>
    <string name="settings_trip_replay">إعادة التشغيل</string>
    <string name="settings_trip_read_error">تعذر قراءة هذه الرحلة</string>
    <string name="settings_trip_share">مشاركة</string>
    <string name="settings_trip_share_title">مشاركة هذه الرحلة</string>
    <string name="settings_trip_share_explain">تبدأ الرحلة المسجلة وتنتهي في الأماكن التي بدأت وانتهيت فيها. يحذف القص كل نقاط GPS القريبة من البداية والنهاية والوجهة ومن المنزل والعمل، ويُبقي الجزء الأوسط بالدقة الكاملة.</string>
    <string name="settings_trip_share_radius">مسافة القص</string>
    <string name="settings_trip_share_radius_m">%1$d م</string>
    <string name="settings_trip_share_summary">يحذف %1$d من النقاط المسجلة ويُبقي %2$d. أي %3$d م من البداية و%4$d م من النهاية.</string>
    <string name="settings_trip_share_also">تُحذف أيضًا الوجهة واسم الرحلة والتعليمات الصوتية عند الطرفين وبداية خط المسار. ويُعاد ضبط الأوقات حتى لا يكشف الملف متى قدت.</string>
    <string name="settings_trip_share_first">أول نقطة متبقية: %1$s، %2$s. تأكد من أنها ليست مكانًا يكشف هويتك.</string>
    <string name="settings_trip_share_trimmed">مشاركة بعد القص</string>
    <string name="settings_trip_share_full">مشاركة المسار الكامل</string>
    <string name="settings_trip_scrub_short">هذه الرحلة أقصر من مسافة القص، لذلك لا يتبقى جزء أوسط للمشاركة. جرّب مسافة أصغر.</string>
    <string name="settings_trip_delete">حذف الرحلة</string>
    <string name="settings_trip_rename">إعادة تسمية</string>
    <string name="settings_trip_rename_title">تسمية هذه الرحلة</string>
    <string name="settings_trip_rename_hint">اسم الرحلة</string>
    <string name="settings_trip_rename_failed">تعذر إعادة تسمية هذه الرحلة</string>
    <string name="settings_trip_select">تحديد الرحلات</string>
    <string name="settings_trip_select_done">تم</string>
